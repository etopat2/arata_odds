# Optional, local PostgreSQL. No third-party data API keys required.
# DATABASE_URL=postgresql://arata:arata-local-only@127.0.0.1:5432/arata
# PGSSL=require
# ARATA_FRONTEND_ORIGIN=http://localhost:5173
# Fresh local database only: start:local supplies this temporary admin password automatically.
# ARATA_ADMIN_INITIAL_PASSWORD=Admin@123
# ARATA_ADMIN_EMAIL=etomet2patrick@gmail.com
# User temporary passwords are generated separately for each account.
# For a publicly accessible server, override ARATA_ADMIN_INITIAL_PASSWORD with a unique random secret before its first request.
